{
  "name": "qhy-coding-agent-ts",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal CLI agent built with AI SDK 7",
  "type": "module",
  "engines": {
    "node": "24.22.2",
    "pnpm": "9.12.3"
  },
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run",
    "check": "pnpm typecheck && pnpm test",
    "smoke": "pnpm build && node dist/cli.js --workspace ./demo --smoke-tool",
    "demo:test": "tsx --test demo/src/*.test.ts",
    "demo:bug": "tsx --test demo/regression/*.test.ts",
    "demo:init": "node scripts/init-demo.mjs",
    "agent:implement": "tsx .sandcastle/agent-workflows/implement/implement.ts",
    "agent:review": "tsx .sandcastle/agent-workflows/review/review.ts",
    "agent:qa-only": "tsx .sandcastle/agent-workflows/qa-only/qa-only.ts",
    "agent:qa": "tsx .sandcastle/agent-workflows/qa/qa.ts",
    "agent:implement-pr": "tsx .sandcastle/agent-workflows/implement-pr/implement-pr.ts",
    "agent:update-branch": "tsx .sandcastle/agent-workflows/update-branch/update-branch.ts",
    "agent:explore": "tsx .sandcastle/agent-workflows/explore/explore.ts",
    "agent:explore:apply": "tsx .sandcastle/agent-workflows/explore/apply.ts"
  },
  "dependencies": {
    "@ai-sdk/mcp": "2.0.90",
    "@ai-sdk/openai": "4.0.108",
    "ai": "7.0.162",
    "ajv": "8.20.0",
    "ignore": "7.0.14",
    "minimatch": "11.0.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "0.14.0",
    "@openai/codex": "0.166.0",
    "@standard-schema/spec": "1.1.0",
    "@types/node": "24.19.2",
    "libsodium-wrappers": "0.8.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
