{
  "name": "qhy-coding-agent-ts",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal CLI agent built with AI SDK 7",
  "type": "module",
  "engines": {
    "node": "24.22.2",
    "pnpm": "9.12.3"
  },
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run",
    "check": "pnpm typecheck && pnpm test",
    "smoke": "pnpm build && node dist/cli.js --workspace ./demo --smoke-tool",
    "demo:test": "tsx --test demo/src/*.test.ts",
    "demo:bug": "tsx --test demo/regression/*.test.ts",
    "demo:init": "node scripts/init-demo.mjs",
    "agent:task": "tsx .sandcastle/task.ts",
    "agent:implement": "tsx .sandcastle/implement.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.108",
    "ai": "7.0.162",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "0.14.0",
    "@openai/codex": "0.166.0",
    "@types/node": "24.19.2",
    "libsodium-wrappers": "0.8.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
